{
    "homepage": "https://arjunsudheer.github.io/personal-website/",
    "name": "personal-website",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "build": "pnpm typecheck && vite build",
        "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "predeploy": "pnpm build",
        "deploy": "gh-pages -d dist -b gh-pages -r https://x-access-token:$GITHUB_TOKEN@github.com/arjunsudheer/personal-website.git",
        "preinstall": "npx only-allow pnpm"
    },
    "dependencies": {
        "gh-pages": "^6.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "prettier": "3.9.9",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "unified": "^11.0.5",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
