{
    "homepage": "https://arjunsudheer.github.io/personal-website/",
    "name": "personal-website",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "predeploy": "pnpm build",
        "deploy": "gh-pages -d dist -b gh-pages -r https://x-access-token:$GITHUB_TOKEN@github.com/arjunsudheer/personal-website.git",
        "preinstall": "npx only-allow pnpm"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "classnames": "^2.5.1",
        "framer-motion": "^13.5.1",
        "gh-pages": "^6.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-icons": "^5.7.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.4",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "prettier": "3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
