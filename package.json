{
  "homepage": "https://arjunsudheer.github.io/personal-website/",
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist -b gh-pages -r https://x-access-token:$GITHUB_TOKEN@github.com/arjunsudheer/personal-website.git",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "classnames": "^2.5.1",
    "framer-motion": "^12.40.0",
    "gh-pages": "^6.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  }
}
